DB_HOST=your_mysql_host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password

# Local Hugging Face summarization for job descriptions (no API key needed).
# Model downloads automatically on first crawl (~300MB for the default DistilBART).
# Uses the seq2seq generate() API so it works with transformers 5.x.
SUMMARIZE_JOB_DESCRIPTIONS=true
AI_MODEL=sshleifer/distilbart-cnn-12-6

CRAWLER_SCHEDULE=0 2 * * *
